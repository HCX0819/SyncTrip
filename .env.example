# Copy to .env.local for local development. Set the same variables per
# environment in Vercel (Preview -> staging Supabase, Production -> prod Supabase).

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mapbox Search API token, used server-side by /api/geocode.
# Optional: falls back to OpenStreetMap Nominatim when unset.
MAPBOX_TOKEN=
# Legacy fallback read by /api/geocode if MAPBOX_TOKEN is unset (prefer MAPBOX_TOKEN).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Sentry error monitoring. Leave NEXT_PUBLIC_SENTRY_DSN empty to disable Sentry.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only: source map upload. Upload is skipped when SENTRY_AUTH_TOKEN is empty.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
